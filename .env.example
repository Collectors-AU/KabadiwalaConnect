# Kabadiwala Connect Environment Configuration

# Backend
DATABASE_URL=sqlite:///./kabadiwala.db
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Storage
STORAGE_PATH=./uploads

# AI Provider (optional - demo mode works without this)
AI_PROVIDER=demo
AI_API_KEY=

# Demo Mode
DEMO_MODE=true

# Secret key for JWT (change in production)
SECRET_KEY=kabadiwala-demo-secret-key-change-in-production

# Mobile app API URL (use 10.0.2.2 for Android emulator)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
